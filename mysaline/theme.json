{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"layout": {
			"contentSize": "800px",
			"wideSize": "1100px"
		},
		"appearanceTools": true,
		"color": {
			"defaultPalette": true,
			"custom": true,
			"palette": [
				{ "slug": "primary", "color": "#0b2545", "name": "Primary" },
				{ "slug": "primary-dark", "color": "#071a33", "name": "Primary Dark" },
				{ "slug": "accent", "color": "#c8102e", "name": "Accent" },
				{ "slug": "highlight", "color": "#f2b705", "name": "Highlight" },
				{ "slug": "surface", "color": "#f4f6f9", "name": "Surface" },
				{ "slug": "text", "color": "#1a1d23", "name": "Text" },
				{ "slug": "muted", "color": "#5b6472", "name": "Muted" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			]
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.08rem", "name": "Medium" },
				{ "slug": "large", "size": "1.35rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#1a1d23"
		},
		"typography": {
			"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": { "color": { "text": "#17457f" } },
			"h1": { "typography": { "fontFamily": "Georgia, \"Times New Roman\", Times, serif" }, "color": { "text": "#0b2545" } },
			"h2": { "typography": { "fontFamily": "Georgia, \"Times New Roman\", Times, serif" }, "color": { "text": "#0b2545" } },
			"h3": { "typography": { "fontFamily": "Georgia, \"Times New Roman\", Times, serif" }, "color": { "text": "#0b2545" } }
		}
	}
}
