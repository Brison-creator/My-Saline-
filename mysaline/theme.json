{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"layout": {
			"contentSize": "800px",
			"wideSize": "1100px"
		},
		"appearanceTools": true,
		"color": {
			"defaultPalette": true,
			"custom": true,
			"palette": [
				{ "slug": "primary", "color": "#0f2b4e", "name": "MySaline Navy" },
				{ "slug": "primary-dark", "color": "#091c34", "name": "Deep Navy" },
				{ "slug": "sky", "color": "#9fd3f0", "name": "Salt Crystal" },
				{ "slug": "sky-soft", "color": "#cfe7f7", "name": "Sky Tint" },
				{ "slug": "cream", "color": "#fbf7ef", "name": "Cream" },
				{ "slug": "cream-deep", "color": "#f3ebdd", "name": "Deep Cream" },
				{ "slug": "accent", "color": "#b2452f", "name": "Brick" },
				{ "slug": "highlight", "color": "#e3a93c", "name": "Honey" },
				{ "slug": "surface", "color": "#eaf4fc", "name": "Sky Wash" },
				{ "slug": "text", "color": "#1e2c36", "name": "Ink" },
				{ "slug": "muted", "color": "#5c6b77", "name": "Muted" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			]
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.08rem", "name": "Medium" },
				{ "slug": "large", "size": "1.35rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#1e2c36"
		},
		"typography": {
			"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": { "color": { "text": "#0b5ce8" } },
			"h1": { "typography": { "fontFamily": "Georgia, \"Times New Roman\", Times, serif" }, "color": { "text": "#0f2b4e" } },
			"h2": { "typography": { "fontFamily": "Georgia, \"Times New Roman\", Times, serif" }, "color": { "text": "#0f2b4e" } },
			"h3": { "typography": { "fontFamily": "Georgia, \"Times New Roman\", Times, serif" }, "color": { "text": "#0f2b4e" } }
		}
	}
}
